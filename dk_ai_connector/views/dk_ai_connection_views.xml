<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_dk_ai_connection_form" model="ir.ui.view">
        <field name="name">dk.ai.connection.form</field>
        <field name="model">dk.ai.connection</field>
        <field name="arch" type="xml">

            <form string="DK AI Connection">

                <header>

                    <button
                        name="action_generate_pairing_code"
                        type="object"
                        string="Generate Pairing Code"
                        class="btn-primary"
                    />

                    <button
                        name="action_exchange_pairing"
                        type="object"
                        string="Exchange Credential"
                        class="btn-primary"
                        attrs="{'invisible': [('status', '!=', 'pending')]}"
                    />

                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                    />

                    <button
                        name="action_revoke_connection"
                        type="object"
                        string="Revoke Connection"
                        class="btn-secondary"
                        attrs="{'invisible': [('status', '!=', 'connected')]}"
                    />

                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="disconnected,pending,connected"
                    />

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group string="DK AI Platform">

                        <field name="dk_ai_url"/>

                    </group>

                    <separator string="Connection"/>

                    <group>

                        <group>

                            <field
                                name="pairing_code"
                                readonly="1"
                                placeholder="Generate a pairing code"
                            />

                            <field
                                name="pairing_expires_at"
                                readonly="1"
                            />

                        </group>

                        <group>

                            <field
                                name="connection_id"
                                readonly="1"
                            />

                            <field
                                name="connected_at"
                                readonly="1"
                            />

                            <field
                                name="connector_token_created_at"
                                readonly="1"
                            />

                        </group>

                    </group>

                    <separator string="Diagnostics"/>

                    <group>

                        <field
                            name="last_test_at"
                            readonly="1"
                        />

                        <field
                            name="active"
                        />

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <record id="view_dk_ai_connection_tree" model="ir.ui.view">
        <field name="name">dk.ai.connection.tree</field>
        <field name="model">dk.ai.connection</field>
        <field name="arch" type="xml">

            <tree string="DK AI Connections">

                <field name="name"/>
                <field name="dk_ai_url"/>
                <field name="status"/>
                <field name="connection_id"/>
                <field name="connected_at"/>

            </tree>

        </field>
    </record>


    <record id="action_dk_ai_connection" model="ir.actions.act_window">

        <field name="name">DK AI Connection</field>
        <field name="res_model">dk.ai.connection</field>
        <field name="view_mode">tree,form</field>

    </record>

</odoo>